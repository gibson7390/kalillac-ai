# --- billing: Stripe TEST mode only (docs/STRIPE_TEST_MODE_SETUP.md) -------------------------------------------
KALILLAC_BILLING_ENABLED=true
KALILLAC_STRIPE_MODE=test
KALILLAC_STRIPE_PRICE_ID=<OWNER_STRIPE_TEST_PRICE_ID>
