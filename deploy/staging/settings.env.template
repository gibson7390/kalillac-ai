KALILLAC_REASONING_MODE_BALANCED_EFFORT=medium
KALILLAC_REASONING_MODE_DEEP_EFFORT=high
KALILLAC_REASONING_MODE_QUICK_EXTRA_OUTPUT_TOKENS=0
