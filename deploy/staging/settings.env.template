# Kalillac AI staging: application settings. Copy to <DIR>/settings.env on the staging host and replace
# every <PLACEHOLDER>. systemd EnvironmentFile syntax: KEY=VALUE, no quotes, no inline comments.
#
# What is NOT in this file:
#   * the settings that must match the provisioned database (roles, database, deployment id, protected-file
#     paths): provision_deployment.py writes them to <DIR>/deployment.env, the unit's first EnvironmentFile;
#   * secrets: they are systemd credentials (see kalillac-staging.service.template), never environment
#     files, except the three provider keys below that the application reads only from its environment.
#
# Placeholders marked OWNER are commercial decisions (allowances, budgets, the Price): staging needs a
# value, and the value is the owner's. PRICE placeholders are the providers' published prices on the day
# staging is configured. HOST placeholders are facts of the staging host.
# PROD placeholders are operational limits: use the value production runs with today (an operator reads it
# from production's unit; it is not recorded in the repository), so staging behaves as production will.
# tools/verify_provisioned_boot.py starts the real application from this file with synthetic values, so
# a setting the application requires cannot be missing from it.

# --- core -----------------------------------------------------------------------------------------------
KALILLAC_ACCOUNTS_ENABLED=true
KALILLAC_SITE_ORIGIN=https://<HOST_STAGING_HOSTNAME>
KALILLAC_ACCOUNT_COOKIE_SECURE=true
KALILLAC_RELEASE_SHA=<HOST_RELEASE_SHA>
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
KALILLAC_SEARCH_PRIMARY=brave
KALILLAC_SEARCH_FALLBACK=tavily

# --- account security (V1), registration, recovery and email ----------------------------------------------
KALILLAC_V1_ACCOUNT_SECURITY_ENABLED=true
KALILLAC_ACCOUNT_REGISTRATION_V2_ENABLED=true
KALILLAC_ACCOUNT_REGISTRATION_URL=https://<HOST_STAGING_HOSTNAME>/account/create/confirm
KALILLAC_ACCOUNT_RECOVERY_ENABLED=true
KALILLAC_ACCOUNT_RECOVERY_URL=https://<HOST_STAGING_HOSTNAME>/account/recovery/confirm
KALILLAC_EMAIL_PROVIDER=resend
KALILLAC_EMAIL_FROM=<HOST_EMAIL_SENDER>

# --- usage, request budgets, provider ceilings ---------------------------------------------------------------
KALILLAC_USAGE_METERING_ENABLED=true
KALILLAC_USAGE_ENFORCEMENT_ENABLED=true
KALILLAC_USAGE_LIMIT_FREE_DAILY=<OWNER_FREE_DAILY_RESPONSES>
