KALILLAC_TAVILY_EXTRACT_MAX_BYTES=<PROD_TAVILY_EXTRACT_MAX_BYTES>
KALILLAC_ANONYMOUS_DAILY_LIMIT_ENABLED=true
KALILLAC_ANONYMOUS_DAILY_LIMIT=10
KALILLAC_PROVIDER_CEILINGS_ENABLED=true
KALILLAC_OPENAI_TOTAL_ATTEMPTS=<OWNER_OPENAI_TOTAL_ATTEMPTS>
