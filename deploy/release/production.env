# Kalillac AI production environment facts for deploy/release. KEY=VALUE, parsed (never sourced).
# Changing this file is a reviewed source change. No secret belongs here.
ENVIRONMENT_KIND=production
SERVICE=kalillac-ai-fastapi-staging.service
RELEASE_PARENT=/opt
RELEASE_PREFIX=kalillac-release-
VENV=/opt/kalillac-venv-440924a9
DROPIN_DIR=/etc/systemd/system/kalillac-ai-fastapi-staging.service.d
ROLLBACK_PARENT=/opt/kalillac-rollbacks
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8001
HEALTH_PATH=/api/health
HEALTH_BODY={"status":"ok"}
# Start-up allowance after a restart, and how many consecutive healthy checks (2 s apart, same PID) count.
HEALTH_TIMEOUT_SECONDS=120
HEALTH_STABLE_CHECKS=3
WEBROOT=/var/www/html
# The production launcher is a deployment artifact: untracked, root-only, copied from the running
# release and compared by content. It is the only untracked file a release directory may hold.
LAUNCHER_NAME=launch-production.py
LAUNCHER_OWNER=root:root
LAUNCHER_MODE=600
DEPLOY_ARTIFACTS=launch-production.py
# systemd starts "<venv python> <release>/launch-production.py"; the launcher replaces itself (exec)
# with exactly this server invocation, in the release's candidate directory, keeping the main PID.
# Observed on the live f347e50f process. Compared argument by argument, never as a substring.
PROCESS_ARGV=/opt/kalillac-venv-440924a9/bin/python3 /opt/kalillac-venv-440924a9/bin/uvicorn app_fastapi_candidate:api --host 127.0.0.1 --port 8001 --workers 1
REQUIRED_UNITS=nginx.service
PUBLIC_BASE=https://kalillac.ai
APP_PREFLIGHT=import
# Read-only revision and ledger check through local peer authentication (no password involved).
# The runtime application role is deliberately denied SELECT on alembic_version.
DB_CHECK=psql-peer
DB_OS_USER=postgres
DB_NAME=kalillac
DB_SCHEMA=kalillac
