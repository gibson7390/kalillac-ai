# Release facts: Financial Safeguards V1 batch 2, deployed with every new financial control OFF.
# KEY=VALUE, parsed (never sourced). Packaged as release.env.
RELEASE_COMMIT=54e38ecf36a4a25db20946019dd298311a632c1d
RELEASE_SHORT=54e38ecf
RELEASE_TITLE=Financial Safeguards V1 batch 2, all financial controls off
PREVIOUS_COMMIT=f347e50fcec13db9e85399612ed5c2ca3b26c706
PREVIOUS_SHORT=f347e50f
# git rev-parse <commit>:candidate/app_fastapi_candidate.py
APP_BLOB=9f921b4428e8a66bd2dac38bf6bbb8b5698ec38b
PREVIOUS_APP_BLOB=b010aa5fc2d1a4d23a11443309d09ccc09cfbbef
# Identical Git trees in both commits: the web root and the Python environment are kept unchanged.
IDENTICAL_PATHS=frontend site requirements-production-lock.txt requirements-database.txt requirements-billing.txt
# Schema: migration 0015 is already applied in production; nothing here migrates.
MIGRATION_HEAD=0015_finance_ledger
DB_REVISION=0015_finance_ledger
EMPTY_TABLES=finance_ledger_buckets finance_reservations finance_unsafe_latches
# Feature state that must hold before and after activation, in the live service environment.
FLAGS_OFF=KALILLAC_FINANCIAL_SAFEGUARDS_ENABLED KALILLAC_ACCOUNTS_ENABLED KALILLAC_BILLING_ENABLED KALILLAC_SPACES_ENABLED KALILLAC_USAGE_METERING_ENABLED KALILLAC_USAGE_ENFORCEMENT_ENABLED KALILLAC_V1_ACCOUNT_SECURITY_ENABLED KALILLAC_ACCOUNT_REGISTRATION_V2_ENABLED KALILLAC_ACCOUNT_RECOVERY_ENABLED KALILLAC_ACCOUNT_EMAIL_VERIFICATION_ENABLED
FLAGS_ON=KALILLAC_PROVIDER_CEILINGS_ENABLED KALILLAC_DB_ENABLED KALILLAC_REQUEST_BUDGET_ENABLED KALILLAC_ANONYMOUS_DAILY_LIMIT_ENABLED
FLAG_VALUES=KALILLAC_ANONYMOUS_DAILY_LIMIT=10 KALILLAC_SEARCH_PRIMARY=brave KALILLAC_SEARCH_FALLBACK=tavily
OPENAI_MODEL_ALLOWED=gpt-6-luna
INACTIVE_GET=/api/account/session /api/account/usage /api/account/billing /api/spaces
INACTIVE_POST=/api/billing/stripe/webhook
INACTIVE_PREFIXES=/api/account /api/spaces /api/billing
